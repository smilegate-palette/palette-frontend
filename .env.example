# 백엔드 API 서버 주소 (2026.08 배포됨)
VITE_API_BASE_URL=http://129.225.197.4:8080

# true(기본값)면 mock 데이터 사용, false면 실제 API 호출
# 엔드포인트 별로 진행도 확인하면서 하나씩 false로 전환
VITE_USE_MOCK=true

# Supabase Auth (JWT) - 로그인/회원가입에 필요. 프로젝트 URL/anon key는
# 백엔드 담당자에게 Supabase 대시보드에서 직접 받아서 채워주세요 (비밀키 아닌 anon/public key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# TODO: 구글/카카오는 Supabase 기본 지원이라 바로 연동 가능.
# 네이버는 Supabase가 기본 지원 안 해서 백엔드가 커스텀 플로우로 어떻게 처리할지 확인 필요.
