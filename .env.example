# 백엔드 API 서버 주소 (2026.08 배포됨)
VITE_API_BASE_URL=http://129.225.197.4:8080

# true(기본값)면 mock 데이터 사용, false면 실제 API 호출
# 엔드포인트 별로 진행도 확인하면서 하나씩 false로 전환
VITE_USE_MOCK=true

# 소셜로그인 client id (구글은 미사용 - 각 제공자 개발자센터에서 앱 등록 후 발급받는 값, secret 아니고 공개 가능한 값).
# ⚠️ Supabase Auth는 안 씀 - 백엔드가 자체 JWT라서, 소셜로그인도 백엔드가 code->accesstoken으로
# 교환해주는 엔드포인트(/api/login/{provider}, 아직 미완성)를 통해 처리합니다.
# 아래 redirect URI를 각 제공자 개발자센터에 콜백 URL로 등록해야 함:
#   {배포주소}/auth/callback/kakao
#   {배포주소}/auth/callback/naver
VITE_KAKAO_CLIENT_ID=
VITE_NAVER_CLIENT_ID=
